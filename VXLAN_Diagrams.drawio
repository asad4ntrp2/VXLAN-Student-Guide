        <mxCell id="bumbox1" value="Multicast&#xa;- VNI mapped to mcast group&#xa;- Efficient delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
