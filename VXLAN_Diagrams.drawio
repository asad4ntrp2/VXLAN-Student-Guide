        <mxCell id="diff2" value="DNA Center is mandatory for Cisco; Juniper is more flexible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
