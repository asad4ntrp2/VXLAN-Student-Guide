        <mxCell id="diff1" value="LISP vs EVPN: Different control plane philosophies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="150" y="440" width="550" height="30" as="geometry" />
