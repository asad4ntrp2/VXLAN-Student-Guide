          <mxGeometry x="655" y="280" width="35" height="12" as="geometry" />
        </mxCell>
        <!-- Route Types Table -->
        <mxCell id="routetypes" value="EVPN Route Types" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#2563eb;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rthead" value="Type  |  Name                    |  Purpose" style="text;strokeColor=none;fillColor=#333;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;fontColor=#ffffff;fontSize=11;fontStyle=1" vertex="1" parent="routetypes">
          <mxGeometry y="26" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rt1" value="Type-1 |  Ethernet Auto-Discovery  |  Multi-homing" style="text;strokeColor=none;fillColor=#444;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;fontColor=#ffffff;fontSize=11" vertex="1" parent="routetypes">
          <mxGeometry y="52" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rt2" value="Type-2 |  MAC/IP Advertisement     |  MAC reachability" style="text;strokeColor=none;fillColor=#333;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;fontColor=#10b981;fontSize=11;fontStyle=1" vertex="1" parent="routetypes">
          <mxGeometry y="78" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rt3" value="Type-3 |  Inclusive Multicast      |  BUM handling" style="text;strokeColor=none;fillColor=#444;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;fontColor=#ffffff;fontSize=11" vertex="1" parent="routetypes">
          <mxGeometry y="104" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rt4" value="Type-5 |  IP Prefix                |  External routing" style="text;strokeColor=none;fillColor=#333;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;fontColor=#ffffff;fontSize=11" vertex="1" parent="routetypes">
          <mxGeometry y="130" width="400" height="26" as="geometry" />
        </mxCell>
        <!-- Learning Process -->
        <mxCell id="learningbox" value="MAC Learning via EVPN:&#xa;1. Host A connects to Leaf 1&#xa;2. Leaf 1 learns MAC-A locally&#xa;3. Leaf 1 sends Type-2 route via BGP&#xa;4. All leaves learn: MAC-A -> VTEP 10.0.1.1&#xa;5. No flooding required!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="500" y="400" width="300" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

