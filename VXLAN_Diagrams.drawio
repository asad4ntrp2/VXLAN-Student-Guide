        <mxCell id="step2switch" value="Switch&#xa;CAM:&#xa;AA:AA -> P1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
