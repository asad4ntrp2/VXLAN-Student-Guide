        </mxCell>
        <mxCell id="bumbox2" value="Ingress Replication&#xa;- Unicast to each VTEP&#xa;- No mcast needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
