        <mxCell id="junipertitle" value="Juniper Campus Fabric" style="text;html=1;strokeColor=none;fillColor=#82b366;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="250" height="30" as="geometry" />
